@startuml 在线考试系统用例图
' ============================================================
' 在线考试系统 用例图
' Actor: 管理员 / 教师 / 学生
' 关系: --> 关联, ..> <<include>> / <<extend>>
' 编写: 需求分析师(李明)  日期: 2026-09-30
' ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam ArrowColor #444444
skinparam UsecaseBorderColor #2E86C1
skinparam UsecaseBackgroundColor #EBF5FB
skinparam ActorBorderColor #1A5276
skinparam ActorBackgroundColor #D6EAF8
skinparam RectangleBorderColor #5DADE2

actor "管理员" as Admin
actor "教师" as Teacher
actor "学生" as Student

rectangle "在线考试系统" {

  ' ---------- 公共用例 ----------
  usecase "登录" as UC_Login
  usecase "修改个人信息" as UC_Profile
  usecase "修改密码" as UC_Pwd

  ' ---------- 用户管理 ----------
  package "用户管理" {
    usecase "用户管理(CRUD)" as UC_UserMgmt
    usecase "角色权限控制" as UC_RBAC
    usecase "班级/组织管理" as UC_OrgMgmt
    usecase "系统配置" as UC_SysConfig
    usecase "数据备份" as UC_Backup
    usecase "查看操作日志" as UC_Log
  }

  ' ---------- 题库管理 ----------
  package "题库管理" {
    usecase "题目新增" as UC_QAdd
    usecase "题目编辑" as UC_QEdit
    usecase "题目删除" as UC_QDel
    usecase "题目查询" as UC_QQuery
    usecase "批量导入(Excel)" as UC_QImport
    usecase "批量导出(Excel)" as UC_QExport
    usecase "知识点/难度分类" as UC_QClass
  }

  ' ---------- 试卷管理 ----------
  package "试卷管理" {
    usecase "手动组卷" as UC_ManualPaper
    usecase "随机组卷" as UC_AutoPaper
    usecase "试卷设置" as UC_PaperConfig
    usecase "试卷预览" as UC_PaperPreview
    usecase "试卷列表查询" as UC_PaperList
    usecase "选择题目" as UC_SelectQ
  }

  ' ---------- 考试管理 ----------
  package "考试管理" {
    usecase "发布考试" as UC_PublishExam
    usecase "设置考试时间" as UC_ExamTime
    usecase "指定参考班级" as UC_AssignClass
    usecase "考试状态管理" as UC_ExamStatus
    usecase "考试列表查询" as UC_ExamList
  }

  ' ---------- 在线答题 ----------
  package "在线答题" {
    usecase "查看考试列表" as UC_StuExamList
    usecase "进入考试" as UC_EnterExam
    usecase "题目导航" as UC_Navigate
    usecase "在线答题" as UC_Answer
    usecase "答案暂存" as UC_SaveAnswer
    usecase "计时提醒" as UC_Timer
    usecase "防作弊(切屏/复制)" as UC_AntiCheat
    usecase "交卷" as UC_Submit
  }

  ' ---------- 阅卷 ----------
  package "阅卷" {
    usecase "客观题自动阅卷" as UC_AutoGrade
    usecase "主观题手动阅卷" as UC_ManualGrade
    usecase "阅卷任务列表" as UC_GradeTask
    usecase "成绩复核" as UC_GradeReview
  }

  ' ---------- 成绩统计 ----------
  package "成绩统计" {
    usecase "个人成绩查询" as UC_PersonalScore
    usecase "班级成绩查看" as UC_ClassScore
    usecase "成绩分布统计" as UC_ScoreDist
    usecase "成绩单导出" as UC_ScoreExport
    usecase "答题详情查看" as UC_AnswerDetail
    usecase "错题统计" as UC_WrongQ
  }
}

' ============================================================
' Actor 与用例的关联
' ============================================================

' --- 公共：登录/个人信息/密码 ---
Admin --> UC_Login
Teacher --> UC_Login
Student --> UC_Login
Admin --> UC_Profile
Teacher --> UC_Profile
Student --> UC_Profile
Admin --> UC_Pwd
Teacher --> UC_Pwd
Student --> UC_Pwd

' --- 管理员用例 ---
Admin --> UC_UserMgmt
Admin --> UC_OrgMgmt
Admin --> UC_SysConfig
Admin --> UC_Backup
Admin --> UC_Log

' --- 教师用例 ---
Teacher --> UC_QAdd
Teacher --> UC_QEdit
Teacher --> UC_QDel
Teacher --> UC_QQuery
Teacher --> UC_QImport
Teacher --> UC_QExport
Teacher --> UC_QClass

Teacher --> UC_ManualPaper
Teacher --> UC_AutoPaper
Teacher --> UC_PaperConfig
Teacher --> UC_PaperPreview
Teacher --> UC_PaperList

Teacher --> UC_PublishExam
Teacher --> UC_ExamTime
Teacher --> UC_AssignClass
Teacher --> UC_ExamStatus
Teacher --> UC_ExamList

Teacher --> UC_ManualGrade
Teacher --> UC_GradeTask
Teacher --> UC_GradeReview
Teacher --> UC_ClassScore
Teacher --> UC_ScoreDist
Teacher --> UC_ScoreExport

' --- 学生用例 ---
Student --> UC_StuExamList
Student --> UC_EnterExam
Student --> UC_Answer
Student --> UC_Submit
Student --> UC_PersonalScore
Student --> UC_AnswerDetail
Student --> UC_WrongQ

' ============================================================
' include / extend 关系
' ============================================================

' 用户管理：用户管理 include 角色权限控制
UC_UserMgmt ..> UC_RBAC : <<include>>

' 题库管理：批量导入/导出 extend 题目查询
UC_QImport ..> UC_QQuery : <<extend>>
UC_QExport ..> UC_QQuery : <<extend>>

' 试卷管理：组卷 include 选择题目；随机组卷 extend 手动组卷
UC_ManualPaper ..> UC_SelectQ : <<include>>
UC_AutoPaper ..> UC_SelectQ : <<include>>
UC_AutoPaper ..> UC_ManualPaper : <<extend>>
UC_PaperPreview ..> UC_PaperList : <<extend>>

' 考试管理：发布考试 include 设置考试时间、指定参考班级
UC_PublishExam ..> UC_ExamTime : <<include>>
UC_PublishExam ..> UC_AssignClass : <<include>>

' 在线答题：进入考试 include 题目导航、计时提醒；答题 include 答案暂存；防作弊 extend 答题
UC_EnterExam ..> UC_Navigate : <<include>>
UC_EnterExam ..> UC_Timer : <<include>>
UC_Answer ..> UC_SaveAnswer : <<include>>
UC_AntiCheat ..> UC_Answer : <<extend>>
UC_Submit ..> UC_Answer : <<include>>

' 阅卷：交卷 include 客观题自动阅卷；手动阅卷 extend 阅卷任务；成绩复核 extend 手动阅卷
UC_Submit ..> UC_AutoGrade : <<include>>
UC_ManualGrade ..> UC_GradeTask : <<extend>>
UC_GradeReview ..> UC_ManualGrade : <<extend>>

' 成绩统计：成绩单导出 extend 班级成绩查看；答题详情查看 extend 个人成绩查询；错题统计 extend 个人成绩查询
UC_ScoreExport ..> UC_ClassScore : <<extend>>
UC_AnswerDetail ..> UC_PersonalScore : <<extend>>
UC_WrongQ ..> UC_PersonalScore : <<extend>>
UC_ScoreDist ..> UC_ClassScore : <<extend>>

' 登录 include 角色权限控制（登录后进行权限初始化）
UC_Login ..> UC_RBAC : <<include>>

@enduml